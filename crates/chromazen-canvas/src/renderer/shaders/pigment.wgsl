const SPECTRAL_XYZ_TO_LINEAR_RGB = mat3x3f(
  vec3f(3.24096994190452, -0.969243636280879, 0.0556300796969936),
  vec3f(-1.53738317757009, 1.87596750150772, -0.203976958888976),
  vec3f(-0.498610760293003, 0.0415550574071756, 1.05697151424287),
);

struct SpectralPrimaries {
  wcmy: vec4f,
  rgb: vec3f,
};

fn spectral_srgb_to_linear(srgb: vec3f) -> vec3f {
  return select(pow((srgb + 0.055) / 1.055, vec3f(2.4)), srgb / 12.92, srgb < vec3f(0.04045));
}

fn spectral_linear_to_srgb(lrgb: vec3f) -> vec3f {
  let srgb = select(1.055 * pow(lrgb, vec3f(1.0 / 2.4)) - 0.055, lrgb * 12.92, lrgb < vec3f(0.0031308));
  return clamp(srgb, vec3f(0.0), vec3f(1.0));
}

fn spectral_primaries(srgb: vec3f) -> SpectralPrimaries {
  let l = spectral_srgb_to_linear(srgb);
  let white = min(l.r, min(l.g, l.b));
  let chroma = l - white;
  let cmy = vec3f(
    min(chroma.g, chroma.b),
    min(chroma.r, chroma.b),
    min(chroma.r, chroma.g),
  );
  let rgb = vec3f(
    min(max(0.0, chroma.r - chroma.b), max(0.0, chroma.r - chroma.g)),
    min(max(0.0, chroma.g - chroma.b), max(0.0, chroma.g - chroma.r)),
    min(max(0.0, chroma.b - chroma.g), max(0.0, chroma.b - chroma.r)),
  );
  return SpectralPrimaries(vec4f(white, cmy), rgb);
}

fn spectral_reflectance(primaries: SpectralPrimaries, band: u32) -> f32 {
  let r = dot(SPECTRAL_BASIS_WCMY[band], primaries.wcmy)
    + dot(SPECTRAL_BASIS_RGB[band], primaries.rgb);
  return max(SPECTRAL_EPSILON, r);
}

// Absorption over scattering for a reflectance.
fn spectral_ks(r: f32) -> f32 {
  return (1.0 - r) * (1.0 - r) / (2.0 * r);
}

// Inverse of `spectral_ks`. spectral.js evaluates `1 + ks - sqrt(ks² + 2ks)`, which cancels
// catastrophically in f32 for dark colors whose ks approaches 1e16.
fn spectral_km(ks: f32) -> f32 {
  return 1.0 / (1.0 + ks + sqrt(ks * (ks + 2.0)));
}

// Mixes two non-premultiplied sRGB colors like paint; `t` is the share of `color2`.
fn spectral_mix(color1: vec3f, color2: vec3f, t: f32) -> vec3f {
  if (t <= 0.0) {
    return color1;
  }
  if (t >= 1.0) {
    return color2;
  }
  let primaries1 = spectral_primaries(color1);
  let primaries2 = spectral_primaries(color2);
  var luminance1 = 0.0;
  var luminance2 = 0.0;
  for (var band = 0u; band < SPECTRAL_SIZE; band++) {
    luminance1 += spectral_reflectance(primaries1, band) * SPECTRAL_CMF[band].y;
    luminance2 += spectral_reflectance(primaries2, band) * SPECTRAL_CMF[band].y;
  }
  let concentration1 = (1.0 - t) * (1.0 - t) * luminance1;
  let concentration2 = t * t * luminance2;
  let total = concentration1 + concentration2;
  var xyz = vec3f(0.0);
  for (var band = 0u; band < SPECTRAL_SIZE; band++) {
    let ks = spectral_ks(spectral_reflectance(primaries1, band)) * concentration1
      + spectral_ks(spectral_reflectance(primaries2, band)) * concentration2;
    xyz += spectral_km(ks / total) * SPECTRAL_CMF[band];
  }
  return spectral_linear_to_srgb(SPECTRAL_XYZ_TO_LINEAR_RGB * xyz);
}

fn unpremultiply(color: vec4f) -> vec3f {
  return min(color.rgb / color.a, vec3f(1.0));
}

// Paints premultiplied `source` over premultiplied `backdrop`, mixing where both have paint.
// Alpha composes as source-over; the source's share of the result sets the pigment ratio.
fn pigment_over(source: vec4f, backdrop: vec4f) -> vec4f {
  let alpha = source.a + backdrop.a * (1.0 - source.a);
  if (source.a <= 0.0 || backdrop.a <= 0.0) {
    return source + backdrop * (1.0 - source.a);
  }
  let rgb = spectral_mix(unpremultiply(backdrop), unpremultiply(source), source.a / alpha);
  return vec4f(rgb * alpha, alpha);
}

// Mixes premultiplied colors like paint; `t` is the share of `color2`, and alpha mixes linearly.
fn pigment_mix(color1: vec4f, color2: vec4f, t: f32) -> vec4f {
  let alpha = mix(color1.a, color2.a, t);
  let amount2 = t * color2.a;
  if (amount2 <= 0.0 || alpha - amount2 <= 0.0) {
    return mix(color1, color2, t);
  }
  let rgb = spectral_mix(unpremultiply(color1), unpremultiply(color2), amount2 / alpha);
  return vec4f(rgb * alpha, alpha);
}
